DATABASE_URL=postgres://repetiter:repetiter@localhost:5432/repetiter?sslmode=disable
HTTP_ADDR=:8080

# Local-only: skip Clerk and treat every request as this user.
DEV_USER_ID=local-dev

# At least one text + one TTS key is enough to run.
OPENAI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# EU Mistral by default when that provider is selected.
MISTRAL_BASE_URL=https://api.eu.mistral.ai/v1

# Free Google Translate TTS — no API key; select "Google TTS (free)" in app settings.
# DEFAULT_TTS_PROVIDER=google
# DEFAULT_TTS_MODEL=gtts
# DEFAULT_TTS_VOICE=normal

DEFAULT_TEXT_PROVIDER=mock
DEFAULT_TEXT_MODEL=mock
DEFAULT_TTS_PROVIDER=google
DEFAULT_TTS_MODEL=gtts
DEFAULT_TTS_VOICE=normal
